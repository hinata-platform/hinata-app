# ---- Build stage: compile the Flutter web app ----
# The SDK is cloned from its flutter/flutter release tag, the same release CI
# tests against: ci.yml passes its FLUTTER_VERSION in as a build arg, and the
# default here follows .fvmrc. No prebuilt Flutter image any more —
# ghcr.io/cirruslabs/flutter:stable stopped at 3.44.0 in May 2026, so the
# production image quietly built with an older SDK than the one CI had tested.
FROM debian:trixie-slim AS build
ARG FLUTTER_VERSION=3.47.7
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl git unzip xz-utils \
 && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 --branch "$FLUTTER_VERSION" \
      https://github.com/flutter/flutter.git /sdks/flutter
ENV PATH="/sdks/flutter/bin:$PATH"
RUN flutter config --no-analytics && flutter precache --web
WORKDIR /app

# Generic build: NO backend is baked in. The default server is resolved at
# *runtime* from window.hinataDefaultServer (see web/config.js), which the
# runtime entrypoint below regenerates from the HINATA_DEFAULT_SERVER env on
# every container start. The image on ghcr is therefore server-agnostic — the
# operator sets the backend purely at deployment.

# Copy the full source first: the app has path dependencies under packages/,
# so `pub get` needs them present. pubspec.lock is checked in, so the image
# resolves exactly the versions CI tested.
COPY . .
RUN flutter pub get
# WasmGC build (ships a JS fallback bundle for browsers without WasmGC). Fixes a
# class of canvas/UI rendering glitches vs. the CanvasKit JS build.
RUN flutter build web --wasm --release

# ---- Runtime stage: serve the static build via nginx ----
FROM nginx:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/build/web /usr/share/nginx/html
# Deep-link association files (Option B). Served from the web root so
# https://track.asta.hn/.well-known/* verifies Android App Links + iOS
# Universal Links. assetlinks.json carries the release signing fingerprint.
COPY deploy/well-known/ /usr/share/nginx/html/.well-known/
# Runtime config: regenerate /config.js from $HINATA_DEFAULT_SERVER
# on every container start. nginx:alpine runs every executable *.sh in this dir
# before starting nginx, so no custom ENTRYPOINT is needed. Unset/empty env ⇒
# the app shows the connect screen.
COPY deploy/docker-entrypoint.d/40-hinata-config.sh /docker-entrypoint.d/40-hinata-config.sh
# Pre-create the Connect-challenge include (regenerated by the entrypoint from
# HINATA_DEFAULT_SERVER) so the nginx config is valid even before first start.
RUN chmod +x /docker-entrypoint.d/40-hinata-config.sh \
 && touch /etc/nginx/conf.d/hinata-challenge.inc
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s \
  CMD wget -qO- http://127.0.0.1/ >/dev/null 2>&1 || exit 1
