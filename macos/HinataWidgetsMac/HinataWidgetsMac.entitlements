<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Without the sandbox macOS never lists the widget in the gallery. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- The one record the app writes for the widgets, shared with the Runner,
	     nothing else. No network: the widget never talks to a server. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.ahmadre.hinata</string>
	</array>
</dict>
</plist>
