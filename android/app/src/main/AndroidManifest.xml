<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Hinata needs internet access to talk to the self-hosted server. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Android 13+ (API 33) requires this declared before the app can ask for
         runtime permission to post notifications; without it,
         FirebaseMessaging.requestPermission() has nothing to grant and push
         notifications never display or become tappable. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Voice comments: capture audio from the microphone. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- Time tracking (HIN-100): the end of a focus/break interval is a
         notification scheduled ahead with flutter_local_notifications.
         BOOT_COMPLETED lets the plugin re-arm it after a reboot; VIBRATE is
         the notification's buzz. SCHEDULE_EXACT_ALARM (user-grantable, asked
         for in-app) keeps the alert on the minute; without the grant the app
         schedules an inexact alarm instead. Deliberately no
         USE_EXACT_ALARM (reserved for alarm/calendar apps by Play policy) and
         no foreground service: the timer runs on wall-clock timestamps, so
         nothing has to stay alive in the background. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <application
        android:label="Hinata"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"><!-- flutter_secure_storage: exclude encrypted prefs from auto-backup so a
             restore can't hit InvalidKeyException; auth tokens shouldn't be backed up anyway. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- Let app_links be the single deep-link handler. Without this,
                 Flutter's built-in deep linking also feeds the raw URI
                 (e.g. hinata://auth-callback/?...) to go_router, which can't
                 match it and shows "Page Not Found". app_links still receives
                 both the custom-scheme and verified https App Links. -->
            <meta-data
              android:name="flutter_deeplinking_enabled"
              android:value="false"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Deep links: hinata://auth-callback (SSO), hinata://invite (email invitation),
                 hinata://time (timer notifications and widgets, e.g. hinata://time/focus) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="hinata" android:host="auth-callback"/>
                <data android:scheme="hinata" android:host="invite"/>
                <data android:scheme="hinata" android:host="reset-password"/>
                <data android:scheme="hinata" android:host="time"/>
            </intent-filter>
            <!-- Android App Links (Option B): Hinata Connect is the ONE verified
                 domain for the published client app, so invite/reset links from ANY
                 self-hosted server open the app directly. autoVerify checks
                 https://connect.hinata.ahmadre.com/.well-known/assetlinks.json against
                 this app's signing certificate. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="connect.hinata.ahmadre.com"/>
                <data android:pathPrefix="/l/"/>
            </intent-filter>
        </activity>
        <!-- flutter_local_notifications (v22): fires scheduled notifications,
             re-arms them after a reboot or an app update, and delivers taps on
             notification actions. Not exported: only the system's alarm and
             boot broadcasts and the plugin's own PendingIntents reach them. -->
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ActionBroadcastReceiver" />
        <!-- HIN-102: the timer widget. Exported only for the system's widget
             broadcasts; it reads the one record the app wrote and never acts on
             the timer (a tap opens hinata://time/focus). -->
        <receiver android:name=".TimerWidgetProvider" android:exported="true"
            android:label="@string/timer_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/timer_widget_info" />
        </receiver>
        <!-- HIN-103: the widget buttons and the Quick Settings tile hand
             hinata://timer/<command> to this receiver, which runs the Dart
             action in a background engine. Not exported: only this app's own
             PendingIntents reach it. -->
        <receiver android:name="es.antonborri.home_widget.HomeWidgetBackgroundReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="es.antonborri.home_widget.action.BACKGROUND" />
            </intent-filter>
        </receiver>
        <!-- HIN-103: the timer as a Quick Settings tile. Exported for the
             system only, which binds it with BIND_QUICK_SETTINGS_TILE. -->
        <service android:name=".TimerTileService"
            android:exported="true"
            android:icon="@drawable/ic_qs_timer"
            android:label="@string/timer_widget_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="false" />
        </service>
        <!-- A long press on the tile opens the focus screen. -->
        <activity android:name=".TimerTilePreferencesActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
