<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The one record the app writes for the widgets (HIN-102). Shared with the
	     Runner, nothing else. -->
	<!-- HIN-103: reads the key of a Live Activity, which the Runner writes,
	     to open the sealed state the server sends. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.ahmadre.hinata.shared</string>
	</array>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.ahmadre.hinata</string>
	</array>
</dict>
</plist>
