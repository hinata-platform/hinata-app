<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Keychain access for flutter_secure_storage (auth tokens live in the
	     Keychain, not plaintext prefs). The first group is the default for every
	     item written without one, so it is the app's own identifier, the group
	     the tokens were always in: existing sessions survive the update.
	     HIN-103: the second group is shared with the HinataWidgets extension and
	     holds the keys of Live Activities that take server updates. Profiles
	     allow $(TeamIdentifierPrefix)*, so nothing changes in the portal. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.ahmadre.hinata</string>
		<string>$(AppIdentifierPrefix)com.ahmadre.hinata.shared</string>
	</array>
	<!-- Push notifications (FCM/APNs). The value must match the signing profile's
	     aps-environment. CI archives are signed with the App Store distribution
	     profile (aps-environment = production), so this is "production". For local
	     on-device debug push you'd temporarily switch this to "development". -->
	<key>aps-environment</key>
	<string>production</string>
	<!-- Hinata Connect relay: the ONE verified domain for the published client app, so
	     invite/reset links from ANY self-hosted server open this app. Apple fetches
	     https://connect.hinata.ahmadre.com/.well-known/apple-app-site-association and
	     matches it against this app's appID. The matching provisioning profile must
	     have the Associated Domains capability enabled (fastlane match). -->
	<!-- HIN-102: the one record the timer widgets read, shared with the
	     HinataWidgets extension only. The profile needs the App Groups
	     capability with group.com.ahmadre.hinata (fastlane match). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.ahmadre.hinata</string>
	</array>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:connect.hinata.ahmadre.com</string>
	</array>
</dict>
</plist>
