    "intent.advance.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turns a Pomodoro in Hinata to its next phase: a break after work, work after a break."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schaltet einen Pomodoro in Hinata weiter: nach der Arbeit in die Pause, nach der Pause zur Arbeit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasa un Pomodoro de Hinata a su siguiente fase: descanso tras el trabajo, trabajo tras el descanso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe un Pomodoro de Hinata à la phase suivante : la pause après le travail, le travail après la pause."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переключает помодоро в Hinata на следующую фазу: после работы перерыв, после перерыва работа."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "将 Hinata 中的番茄钟切换到下一阶段：工作后休息，休息后工作。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinata のポモドーロを次のフェーズに進めます。作業のあとは休憩、休憩のあとは作業です。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinata में पोमोडोरो को अगले चरण पर ले जाता है: काम के बाद ब्रेक, ब्रेक के बाद काम।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينقل بومودورو في Hinata إلى مرحلته التالية: استراحة بعد العمل، وعمل بعد الاستراحة."
          }
        }
      }
    },
