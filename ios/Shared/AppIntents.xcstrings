          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدء المؤقت"
          }
        }
      }
    },
    "intent.status.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tells you how long the timer has been running and in which phase, as the lock screen shows it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sagt dir, wie lange der Timer läuft und in welcher Phase, so wie der Sperrbildschirm ihn zeigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te dice cuánto lleva el temporizador y en qué fase, tal como lo muestra la pantalla de bloqueo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Te dit depuis combien de temps le minuteur tourne et dans quelle phase, comme l’écran verrouillé l’affiche."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сообщает, сколько работает таймер и в какой фазе, как это показано на экране блокировки."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "按锁定屏幕上的显示，告诉你计时已进行多久以及处于哪个阶段。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロック画面の表示どおりに、タイマーの経過時間とフェーズをお知らせします。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लॉक स्क्रीन के अनुसार बताता है कि टाइमर कितनी देर से चल रहा है और किस चरण में है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يخبرك منذ متى يعمل المؤقت وفي أي مرحلة، كما تعرضه شاشة القفل."
          }
        }
      }
    },
    "intent.status.title": {
      "extractionState": "manual",
