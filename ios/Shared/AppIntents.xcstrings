    "intent.stop.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stops the running timer in Hinata and saves the time. During a break it ends the session."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppt den laufenden Timer in Hinata und bucht die Zeit. In einer Pause beendet es die Sitzung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detiene el temporizador en curso en Hinata y guarda el tiempo. Durante un descanso termina la sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrête le minuteur en cours dans Hinata et enregistre le temps. Pendant une pause, termine la session."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Останавливает текущий таймер в Hinata и сохраняет время. Во время перерыва завершает сеанс."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "停止 Hinata 中正在运行的计时并记录时间。休息时则结束本次专注。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinata で動いているタイマーを止めて時間を記録します。休憩中はセッションを終了します。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinata में चल रहा टाइमर रोकता है और समय दर्ज करता है। ब्रेक के दौरान सत्र खत्म करता है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوقف المؤقت الجاري في Hinata ويسجّل الوقت. أثناء الاستراحة ينهي الجلسة."
          }
        }
      }
    },
