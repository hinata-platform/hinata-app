      }
    },
    "intent.focus.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens the focus screen of the timer in Hinata."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet den Fokus-Bildschirm des Timers in Hinata."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la pantalla de enfoque del temporizador en Hinata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre l’écran focus du minuteur dans Hinata."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает экран фокуса таймера в Hinata."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Hinata 中计时的专注页面。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinata のタイマーのフォーカス画面を開きます。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinata में टाइमर की फ़ोकस स्क्रीन खोलता है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح شاشة التركيز للمؤقت في Hinata."
          }
        }
      }
    },
