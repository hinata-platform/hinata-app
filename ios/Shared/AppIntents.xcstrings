{
  "sourceLanguage": "en",
  "strings": {
    "control.toggle.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starts and stops the timer without opening Hinata."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startet und stoppt den Timer, ohne Hinata zu öffnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia y detiene el temporizador sin abrir Hinata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarre et arrête le minuteur sans ouvrir Hinata."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запускает и останавливает таймер, не открывая Hinata."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "无需打开 Hinata 即可开始和停止计时。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinata を開かずにタイマーを開始・停止します。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinata खोले बिना टाइमर शुरू और बंद करता है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدأ المؤقت ويوقفه دون فتح Hinata."
          }
        }
      }
    },
