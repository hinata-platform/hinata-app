    "intent.start.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starts a stopwatch in Hinata, with a description and a project if you like."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startet eine Stoppuhr in Hinata, auf Wunsch mit Beschreibung und Projekt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia un cronómetro en Hinata, con descripción y proyecto si quieres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lance un chronomètre dans Hinata, avec une description et un projet si tu veux."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запускает секундомер в Hinata, при желании с описанием и проектом."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Hinata 中开始秒表计时，可选填描述和项目。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinata でストップウォッチを開始します。説明とプロジェクトも指定できます。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinata में स्टॉपवॉच शुरू करता है, चाहें तो विवरण और प्रोजेक्ट के साथ।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدأ ساعة إيقاف في Hinata، مع وصف ومشروع إن أردت."
          }
        }
      }
    },
    "intent.start.title": {
      "extractionState": "manual",
